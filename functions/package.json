{
  "name": "karar-veriyorum-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "cd .. && npx --yes firebase-tools emulators:exec --only firestore --project demo-karar \"cd functions && npx vitest run --config vitest.rules.config.ts\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1",
    "openai": "^4.104.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.0.3",
    "eslint": "^9.7.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.3"
  }
}
