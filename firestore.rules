rules_version = '2';

// Karar Veriyorum güvenlik kuralları — docs/FIRESTORE-VERI-MODELI.md ile senkron.
// İlke: istemci yalnız kendi verisini okur/yazar; sunucu-sahipli alanlar ve
// koleksiyonlar (plan, quota, aiAnalyses, subscriptions) istemciye kapalıdır.
service cloud.firestore {
  match /databases/{db}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Kullanıcı başına karar üst sınırı — functions/src/config.ts
    // MAX_DECISIONS_PER_USER ile SENKRON tutulmalı (rules TS import edemez).
    function maxDecisions() { return 50; }

    // Kullanıcının mevcut karar sayacı (user belgesi/alanı yoksa 0).
    function decisionCount(uid) {
      let path = /databases/$(db)/documents/users/$(uid);
      return exists(path) ? get(path).data.get('decisionCount', 0) : 0;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // plan / planExpiresAt / quota / freeAnalysisCredits / rewardCredits
      // YALNIZ Functions (admin SDK) yazar — kredi manipülasyonu imkânsız.
      // decisionCount istemci yazabilir AMA yalnız ±1 (sıfırlama hilesi
      // engellenir — karar cap'inin bütünlüğü için).
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny([
               'plan', 'planExpiresAt', 'quota',
               'freeAnalysisCredits', 'rewardCredits'
             ])
        && (!request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['decisionCount'])
            || (request.resource.data.decisionCount is int
                && request.resource.data.decisionCount >= 0
                && request.resource.data.decisionCount <=
                     resource.data.get('decisionCount', 0) + 1
                && request.resource.data.decisionCount >=
                     resource.data.get('decisionCount', 0) - 1));

      // İlk kayıt: istemci profil oluşturabilir ama kredi alanlarını
      // GÖNDEREMEZ — başlangıç değerlerini sunucu (lazy-init) uygular.
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'free'
        && !('freeAnalysisCredits' in request.resource.data)
        && !('rewardCredits' in request.resource.data);

      allow delete: if false; // silme yalnız deleteAccount fonksiyonu üzerinden

      match /decisions/{decisionId} {
        function decisionValid() {
          let d = request.resource.data;
          return d.ownerUid == uid                          // audit Y-5
            && d.title is string
            && d.title.size() >= 3 && d.title.size() <= 100
            && d.options is list
            // HOTFIX: alt sınır YOK — taslak 0 seçenekle doğar ('Devam
            // Et' yolu), düzenlemede 1'e düşebilir. "Analiz için min 2"
            // İŞ kuralıdır ve Functions/zod'da zaten zorlanır
            // (schema.ts options.min(2), testli). Üst sınırlar korunur.
            && d.options.size() <= 10                       // Limits.maxOptions
            && d.criteria is list
            && d.criteria.size() <= 15;
          // Eleman-içi derin doğrulama (ad/açıklama/madde limitleri — Y-3)
          // Functions katmanında zod ile; rules üst-seviye şekli korur.
        }

        // SPRINT C.2 — kontrol cevabı karar başına TEK kayıttır.
        // checkInStatus yalnız daha önce YOKKEN yazılabilir; bir kez
        // yazıldıktan sonra değiştirilemez/silinemez. Bu alana hiç
        // dokunmayan güncellemeler (başlık, puan, taahhüt...) serbest.
        function checkInWriteOnce() {
          let touched = request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['checkInStatus']);
          return !touched
            || (!('checkInStatus' in resource.data)
                && request.resource.data.checkInStatus
                     in ['happy', 'neutral', 'regret']);
        }

        // latestAnalysisId ve 'analyzed' statüsü yalnız Functions yazar.
        function serverFieldsUntouched() {
          return !request.resource.data.diff(resource.data)
                   .affectedKeys().hasAny(['latestAnalysisId'])
            && (request.resource.data.status != 'analyzed'
                || resource.data.status == 'analyzed');
        }

        allow read, delete: if isOwner(uid);
        // Hotfix madde 5: kullanıcı başına en fazla maxDecisions() karar.
        allow create: if isOwner(uid) && decisionValid()
          && !('latestAnalysisId' in request.resource.data)
          && request.resource.data.status != 'analyzed'
          && decisionCount(uid) < maxDecisions();
        allow update: if isOwner(uid) && decisionValid()
          && serverFieldsUntouched()
          && checkInWriteOnce();

        // AI analizleri: fiziksel olarak ayrık yazma yolu (AD-9, audit K-2).
        match /aiAnalyses/{analysisId} {
          allow read: if isOwner(uid);
          allow write: if false; // yalnız Functions (admin SDK)
        }
      }

      // Abonelik olay kayıtları: denetim izi, yalnız webhook yazar.
      match /subscriptions/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false; // yalnız revenuecatWebhook (admin SDK)
      }

      // Ödül biletleri (7A): yaşam döngüsü tamamen sunucuda
      // (createRewardTicket → AdMob SSV callback). İstemciye kapalı.
      match /rewardTickets/{ticketId} {
        allow read, write: if false;
      }
    }

    match /templates/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /aiJobs/{id} {
      allow read, write: if false; // ops-iç, yalnız admin SDK
    }

    match /rateLimits/{uid} {
      allow read, write: if false; // sayaçlar yalnız Functions transaction'ı
    }

    // Ops sayaçları (dailySpend / dailyAnalysisCount / dailyTokens):
    // yalnız Functions admin SDK. Default-deny zaten kapatıyor; niyet açık.
    match /ops/{id} {
      allow read, write: if false;
    }
  }
}
