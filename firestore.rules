rules_version = '2';

// Karar Veriyorum güvenlik kuralları — docs/FIRESTORE-VERI-MODELI.md ile senkron.
// İlke: istemci yalnız kendi verisini okur/yazar; sunucu-sahipli alanlar ve
// koleksiyonlar (plan, quota, aiAnalyses, subscriptions) istemciye kapalıdır.
service cloud.firestore {
  match /databases/{db}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---- HESAP SİLME BARİYERİ (İş Paketi 3) ----
    //
    // Hesap silme kaskadı `users/{uid}` ağacını sildikten SONRA Auth
    // kullanıcısı silinene kadar eski ID token GEÇERLİ kalır (token ömrü
    // ~1 saate kadar). O pencerede istemci yazması silinmiş veriyi
    // DİRİLTİR ve yetim bırakır.
    //
    // Bariyer, silme başlarken sunucunun oluşturduğu, İÇERİK TAŞIMAYAN bir
    // belgedir. Varlığı kullanıcı ağacındaki TÜM istemci erişimini kapatır.
    // Belge istemciye tamamen kapalıdır (aşağıdaki match bloğu).
    function deletionBarrierPath(uid) {
      return /databases/$(db)/documents/accountDeletionBlocks/$(uid);
    }

    // Sahiplik VE silme başlamamış olması — kullanıcı ağacındaki her
    // istemci kuralı bunu kullanır; `isOwner` tek başına KULLANILMAZ.
    function accountActive(uid) {
      return isOwner(uid) && !exists(deletionBarrierPath(uid));
    }

    // Kullanıcı başına karar üst sınırı — functions/src/config.ts
    // MAX_DECISIONS_PER_USER ile SENKRON tutulmalı (rules TS import edemez).
    function maxDecisions() { return 50; }

    // ---- Merkezi yol yardımcıları ----
    function userPath(uid) {
      return /databases/$(db)/documents/users/$(uid);
    }
    function decisionPath(uid, decisionId) {
      return /databases/$(db)/documents/users/$(uid)/decisions/$(decisionId);
    }

    // Kullanıcının BATCH ÖNCESİ karar sayacı (belge/alan yoksa 0).
    function decisionCount(uid) {
      return exists(userPath(uid)) ? get(userPath(uid)).data.get('decisionCount', 0) : 0;
    }

    // ---- SECURITY: sayaç ↔ atomik karar yazımı bağı ----
    //
    // decisionCount TEK BAŞINA ilerletilemez: yalnız AYNI batch'te gerçek
    // bir karar create/delete edilir ve decisionCountMutationId o kararın
    // id'sini taşırsa geçerlidir. Aksi hâlde tekrarlı azaltımla 50 karar
    // sınırı aşılabiliyordu.
    function counterKeysTouched() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['decisionCount', 'decisionCountMutationId']);
    }

    // Sayaç +1: karar batch ÖNCESİ yok, SONRASI var.
    function atomicCountUp(uid) {
      let mid = request.resource.data.get('decisionCountMutationId', '');
      let before = resource.data.get('decisionCount', 0);
      return mid is string && mid != ''
        && !exists(decisionPath(uid, mid))
        && existsAfter(decisionPath(uid, mid))
        && request.resource.data.decisionCount == before + 1
        && before < maxDecisions();
    }

    // Sayaç -1: karar batch ÖNCESİ var, SONRASI yok.
    function atomicCountDown(uid) {
      let mid = request.resource.data.get('decisionCountMutationId', '');
      let before = resource.data.get('decisionCount', 0);
      return mid is string && mid != ''
        && exists(decisionPath(uid, mid))
        && !existsAfter(decisionPath(uid, mid))
        && request.resource.data.decisionCount == before - 1
        && request.resource.data.decisionCount >= 0;
    }

    // İlk user belgesi + ilk karar aynı batch'te (sayaç 0 → 1).
    function atomicCountOnUserCreate(uid) {
      let mid = request.resource.data.get('decisionCountMutationId', '');
      return mid is string && mid != ''
        && !exists(decisionPath(uid, mid))
        && existsAfter(decisionPath(uid, mid))
        && request.resource.data.decisionCount == 1;
    }

    // Karar tarafı (çift yönlü bağ): user sayacının PROJECTED durumu
    // bu karar için doğru yönde ilerlemiş olmalı.
    function counterBoundToDecision(uid, decisionId, delta) {
      let before = decisionCount(uid);
      let after = getAfter(userPath(uid)).data;
      return after.get('decisionCount', 0) == before + delta
        && after.get('decisionCountMutationId', '') == decisionId;
    }

    match /users/{uid} {
      allow read: if accountActive(uid);

      // plan / planExpiresAt / quota / freeAnalysisCredits / rewardCredits
      // YALNIZ Functions (admin SDK) yazar — kredi manipülasyonu imkânsız.
      // decisionCount istemci yazabilir AMA yalnız ±1 (sıfırlama hilesi
      // engellenir — karar cap'inin bütünlüğü için).
      allow update: if accountActive(uid)
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny([
               'plan', 'planExpiresAt', 'quota',
               'freeAnalysisCredits', 'rewardCredits'
             ])
        // Sayaç/marker alanlarına dokunuluyorsa GERÇEK atomik mutasyon şart.
        && (!counterKeysTouched()
            || (request.resource.data.decisionCount is int
                && (atomicCountUp(uid) || atomicCountDown(uid))));

      // İlk kayıt: istemci profil oluşturabilir ama kredi alanlarını
      // GÖNDEREMEZ — başlangıç değerlerini sunucu (lazy-init) uygular.
      allow create: if accountActive(uid)
        && request.resource.data.plan == 'free'
        && !('planExpiresAt' in request.resource.data)
        && !('quota' in request.resource.data)
        && !('freeAnalysisCredits' in request.resource.data)
        && !('rewardCredits' in request.resource.data)
        // Sayaç alanları ilk yazımda da yalnız atomik karar create'iyle:
        && (!('decisionCount' in request.resource.data)
              && !('decisionCountMutationId' in request.resource.data)
            || atomicCountOnUserCreate(uid));

      allow delete: if false; // silme yalnız deleteAccount fonksiyonu üzerinden

      match /decisions/{decisionId} {
        function decisionValid() {
          let d = request.resource.data;
          return d.ownerUid == uid                          // audit Y-5
            && d.title is string
            && d.title.size() >= 3 && d.title.size() <= 100
            && d.options is list
            // HOTFIX: alt sınır YOK — taslak 0 seçenekle doğar ('Devam
            // Et' yolu), düzenlemede 1'e düşebilir. "Analiz için min 2"
            // İŞ kuralıdır ve Functions/zod'da zaten zorlanır
            // (schema.ts options.min(2), testli). Üst sınırlar korunur.
            && d.options.size() <= 10                       // Limits.maxOptions
            && d.criteria is list
            && d.criteria.size() <= 15;
          // Eleman-içi derin doğrulama (ad/açıklama/madde limitleri — Y-3)
          // Functions katmanında zod ile; rules üst-seviye şekli korur.
        }

        // SPRINT C.2 — kontrol cevabı karar başına TEK kayıttır.
        // checkInStatus yalnız daha önce YOKKEN yazılabilir; bir kez
        // yazıldıktan sonra değiştirilemez/silinemez. Bu alana hiç
        // dokunmayan güncellemeler (başlık, puan, taahhüt...) serbest.
        function checkInWriteOnce() {
          let touched = request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['checkInStatus']);
          return !touched
            || (!('checkInStatus' in resource.data)
                && request.resource.data.checkInStatus
                     in ['happy', 'neutral', 'regret']);
        }

        // latestAnalysisId ve 'analyzed' statüsü yalnız Functions yazar.
        function serverFieldsUntouched() {
          return !request.resource.data.diff(resource.data)
                   .affectedKeys().hasAny(['latestAnalysisId'])
            && (request.resource.data.status != 'analyzed'
                || resource.data.status == 'analyzed');
        }

        allow read: if accountActive(uid);
        // SECURITY: silme, user sayacının -1 ilerlemesiyle BAĞLIDIR.
        allow delete: if accountActive(uid)
          && counterBoundToDecision(uid, decisionId, -1);
        // Hotfix madde 5: kullanıcı başına en fazla maxDecisions() karar.
        // SECURITY: create, user sayacının +1 ilerlemesiyle BAĞLIDIR.
        allow create: if accountActive(uid) && decisionValid()
          && !('latestAnalysisId' in request.resource.data)
          && request.resource.data.status != 'analyzed'
          && decisionCount(uid) < maxDecisions()
          && counterBoundToDecision(uid, decisionId, 1);
        allow update: if accountActive(uid) && decisionValid()
          && serverFieldsUntouched()
          && checkInWriteOnce();

        // AI analizleri: fiziksel olarak ayrık yazma yolu (AD-9, audit K-2).
        match /aiAnalyses/{analysisId} {
          allow read: if accountActive(uid);
          allow write: if false; // yalnız Functions (admin SDK)
        }
      }

      // Abonelik olay kayıtları: denetim izi, yalnız webhook yazar.
      match /subscriptions/{eventId} {
        allow read: if accountActive(uid);
        allow write: if false; // yalnız revenuecatWebhook (admin SDK)
      }

      // Ödül biletleri (7A): yaşam döngüsü tamamen sunucuda
      // (createRewardTicket → AdMob SSV callback). İstemciye kapalı.
      match /rewardTickets/{ticketId} {
        allow read, write: if false;
      }
    }

    match /templates/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /aiJobs/{id} {
      allow read, write: if false; // ops-iç, yalnız admin SDK
    }

    match /rateLimits/{uid} {
      allow read, write: if false; // sayaçlar yalnız Functions transaction'ı
    }

    // Ops sayaçları (dailySpend / dailyAnalysisCount / dailyTokens):
    // yalnız Functions admin SDK. Default-deny zaten kapatıyor; niyet açık.
    match /ops/{id} {
      allow read, write: if false;
    }

    // Hesap silme bariyeri: yalnız Functions (admin SDK) yazar/okur.
    // İstemci bariyeri okuyamaz (silme durumu sızmaz) ve SİLEMEZ —
    // silebilseydi bariyeri kaldırıp veri diriltebilirdi.
    match /accountDeletionBlocks/{uid} {
      allow read, write: if false;
    }
  }
}
